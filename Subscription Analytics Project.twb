      <column caption='Acquisition Channel' datatype='string' name='[Acquisition_Channel]' role='dimension' type='nominal' />
      <column caption='Cohort Month' datatype='datetime' name='[Calculation_1193842429509632]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, { FIXED [Customer_ID] : MIN([Transaction_Date]) })' />
      </column>
      <column caption='Months Since Start' datatype='integer' name='[Calculation_1193842433310722]' role='measure' type='quantitative'>
